<launch>
    <arg name="config_file" default="sam.yaml"/>
    <arg name ="robot_name" default ="sam_auv_v1"/>
    <arg name="use_motion_model" default="true"/>
    <arg name="use_sim_time" default="true"/>
    <arg name="inference_strategy" default="FullSmoothing"/>
    <arg name = "kf_interval_hz" default = "10"/>
    <arg name = "init_from_ground_truth" default = "false"/>    
    <arg name = "bag_file" default = "/home/axel/colcon_ws/may_22/rosbag2_2025_05_22-15_22_01"/>
    <arg name="robot_urdf" default="sam_auv.urdf"/>
    <arg name="use_sensor_covariance" default="false"/>


    <executable cmd="ros2 bag play $(var bag_file) --clock" output="screen" />
    <node pkg="hydrobatic_localization" exec="state_estimator" output="screen" namespace = "$(var robot_name)">
        <param name = "config_file" value = "$(var config_file)"/>
        <param name = "use_sim_time" value = "$(var use_sim_time)"/>
        <param name = "use_motion_model" value = "$(var use_motion_model)"/>
        <param name = "inference_strategy" value = '$(var inference_strategy)'/>
        <param name = "init_from_ground_truth" value = "$(var init_from_ground_truth)"/>
        <param name = "kf_interval_hz" value = '$(var kf_interval_hz)'/>
        <param name = "use_sensor_covariance" value = "$(var use_sensor_covariance)"/>
    </node>

    <node pkg="hydrobatic_localization" exec="dvl_raw.py" output="screen" namespace = "$(var robot_name)">
        <param name = "use_sim_time" value = "$(var use_sim_time)"/>
    </node>

    <node pkg="hydrobatic_localization" exec="topic_collector.py" output="screen" namespace = "$(var robot_name)">
        <param name = "use_sim_time" value = "$(var use_sim_time)"/>
        <param name = "robot_name" value = "$(var robot_name)"/>
    </node>
    
    <!-- <node name="robot_state_publisher" pkg="robot_state_publisher" exec="robot_state_publisher" respawn="true" output="screen" namespace="sam_mocap2" >
        <param name="robot_description" value="$(command 'xacro $(find-pkg-share sam_description)/urdf/$(var robot_urdf).xacro ns:=sam_mocap2 ')"/>
    </node> -->

</launch>
